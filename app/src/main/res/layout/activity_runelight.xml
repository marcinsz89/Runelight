<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/runelightRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/runelight_background"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_runelight" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="@color/runelight_text"
            android:textSize="22sp"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/appearanceButton" style="@style/RunelightTextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/runelight_appearance_symbol"
            android:textSize="24sp"
            app:backgroundTint="@color/runelight_card"
            app:strokeColor="@color/runelight_edge"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            android:contentDescription="@string/runelight_appearance" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/lightingTile" style="@style/RunelightCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:background="@drawable/runelight_toggle_surface"
                android:orientation="vertical"
                android:padding="16dp"
                android:minHeight="110dp">
                <TextView style="@style/RunelightLabel"
                    android:text="@string/runelight_lighting"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true"
                    android:textColor="@color/runelight_toggle_secondary" />
                <TextView
                    android:id="@+id/lightingState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/runelight_stopped"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true"
                    android:textColor="@color/runelight_toggle_text"
                    android:textSize="38sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/soundTile" style="@style/RunelightCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            android:enabled="false"
            android:contentDescription="@string/runelight_sound_unavailable">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:background="@drawable/runelight_toggle_surface"
                android:orientation="vertical"
                android:padding="16dp"
                android:minHeight="110dp">
                <TextView style="@style/RunelightLabel"
                    android:text="@string/runelight_sound"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true"
                    android:textColor="@color/runelight_toggle_secondary" />
                <TextView
                    android:id="@+id/soundState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/runelight_off"
                    android:includeFontPadding="false"
                    android:duplicateParentState="true"
                    android:textColor="@color/runelight_toggle_text"
                    android:textSize="38sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/effectButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginTop="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/effectAmbient" style="@style/RunelightEffect"
            android:text="@string/runelight_ambient"
            android:enabled="false"
            android:contentDescription="@string/runelight_ambient_unavailable" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/effectSolid" style="@style/RunelightEffect"
            android:text="@string/runelight_solid" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/effectRainbow" style="@style/RunelightEffect"
            android:text="@string/runelight_rainbow" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/effectBreathing" style="@style/RunelightEffect"
            android:text="@string/runelight_breathing" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/effectPulse" style="@style/RunelightEffect"
            android:text="@string/runelight_pulse" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <LinearLayout
        android:id="@+id/quickConfiguration"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <com.moonbench.bifrost.ui.ColorLevelTile
                android:id="@+id/quickLeftColor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/runelight_left_level" />
            <com.moonbench.bifrost.ui.ColorLevelTile
                android:id="@+id/quickSpeed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/runelight_speed" />
            <com.moonbench.bifrost.ui.ColorLevelTile
                android:id="@+id/quickRightColor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/runelight_right_level" />
        </LinearLayout>
        <TextView
            android:id="@+id/quickStatus" style="@style/RunelightLabel"
            android:layout_marginTop="8dp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/quickColorEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="12dp"
        android:padding="12dp"
        android:background="@drawable/runelight_toggle_surface"
        android:visibility="gone">
        <com.skydoves.colorpickerview.ColorPickerView
            android:id="@+id/quickColorPicker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:contentDescription="@string/runelight_color_wheel"
            app:selector="@drawable/runelight_color_selector" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="center">
            <TextView style="@style/RunelightLabel"
                android:id="@+id/quickColorTitle"
                android:layout_width="match_parent"
                android:gravity="center"
                android:textColor="@color/runelight_text"
                android:textStyle="bold" />
            <View
                android:id="@+id/quickColorPreview"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no" />
            <TextView style="@style/RunelightLabel"
                android:id="@+id/quickColorHex"
                android:layout_marginTop="10dp" />
            <TextView style="@style/RunelightLabel"
                android:id="@+id/quickColorLevel"
                android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton style="@style/RunelightPrimaryButton"
                android:id="@+id/quickApplyColor"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="6dp"
                android:minHeight="48dp"
                android:text="@string/runelight_apply_color"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
            <com.google.android.material.button.MaterialButton style="@style/RunelightSecondaryButton"
                android:id="@+id/quickCopyOther"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:minHeight="48dp"
                android:text="@string/runelight_copy_right"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
            <com.google.android.material.button.MaterialButton style="@style/RunelightSecondaryButton"
                android:id="@+id/quickCancelColor"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:text="@string/runelight_cancel_color"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
