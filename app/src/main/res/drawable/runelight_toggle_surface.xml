<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315" android:startColor="@color/runelight_active_top"
                android:centerColor="@color/runelight_active_middle" android:endColor="@color/runelight_active_bottom" />
            <stroke android:width="1dp" android:color="@color/runelight_active_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315" android:startColor="@color/runelight_card_top"
                android:endColor="@color/runelight_card_bottom" />
            <stroke android:width="1dp" android:color="@color/runelight_edge" />
        </shape>
    </item>
</selector>
